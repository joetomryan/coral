---
// Copied Google reviews, one at a time, crossfading on their own (left), beside a
// fixed collage of the customers' photos (right). No controls: it simply moves.
import { site } from '../data/site';
import { reviews, reviewPhotos } from '../data/reviews';

const [main, ...small] = reviewPhotos;
---

<div class="showcase" data-showcase>
  <div class="rv" data-rv aria-label="Customer reviews">
    <div class="rv__stage">
      {
        reviews.map((r, i) => (
          <article class:list={['rv__quote', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
            <p class="stars" style={`--r: ${r.rating}`} aria-label={`${r.rating} out of 5 stars`}>
              ★★★★★
            </p>
            <blockquote class="rv__text">{r.text}</blockquote>
            <footer class="rv__who">
              <span class="rv__avatar" aria-hidden="true">{r.name.trim()[0]}</span>
              <span>
                <b>{r.name}</b>
                <span class="muted">Google review · {r.when}</span>
              </span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>

  {
    main && (
      <div class="gal">
        <div class="collage">
          <figure class="collage__main">
            <img src={main.src} alt={main.alt} width={main.width} height={main.height} loading="lazy" decoding="async" />
          </figure>
          {small.map((p) => (
            <figure class="collage__cell">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        <a class="gal__credit muted" href={site.google.reviewsUrl} target="_blank" rel="noopener">
          Customer photos from Google
        </a>
      </div>
    )
  }
</div>

<script>
  const REVIEW_MS = 7000;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

    const stage = root.querySelector<HTMLElement>('.rv__stage')!;
    const quotes = [...stage.querySelectorAll<HTMLElement>('.rv__quote')];
    let active = 0;
    // The stage is as tall as the longest review, so the section never jumps.
    const fit = () => stage.style.setProperty('--h', `${Math.max(...quotes.map((q) => q.offsetHeight))}px`);
    const show = (i: number) => {
      active = (i + quotes.length) % quotes.length;
      quotes.forEach((q, j) => {
        q.classList.toggle('is-active', j === active);
        q.setAttribute('aria-hidden', String(j !== active));
      });
    };
    fit();
    document.fonts?.ready.then(fit);
    addEventListener('resize', fit);

    if (reduced) return;

    let last = performance.now();
    let elapsed = 0;
    const tick = (now: number) => {
      const dt = now - last;
      last = now;
      if (visible && !document.hidden) {
        elapsed += dt;
        if (elapsed >= REVIEW_MS) {
          elapsed = 0;
          show(active + 1);
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>

<style>
  .showcase {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .showcase {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  /* ----- Reviews ----- */
  .rv__stage {
    display: grid;
  }

  :global(.js) .rv__stage {
    position: relative;
    height: var(--h, auto);
  }

  .rv__quote {
    grid-area: 1 / 1;
    display: grid;
    gap: 1.1rem;
    align-content: start;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  :global(.js) .rv__quote {
    position: absolute;
    inset: 0 0 auto;
  }

  .rv__quote.is-active {
    opacity: 1;
  }

  .rv__quote:not(.is-active) {
    pointer-events: none;
  }

  .rv__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--ink);
    white-space: pre-line;
  }

  .rv__who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .rv__who > span:last-child {
    display: grid;
  }

  .rv__who b {
    font-weight: 600;
    color: var(--ink);
  }

  .rv__who .muted {
    font-size: 0.8125rem;
  }

  .rv__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  /* ----- Collage: one large photo, three smaller, fixed shapes ----- */
  .gal {
    display: grid;
    gap: 0.6rem;
  }

  .collage {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.5rem;
    max-width: 100%;
  }

  .collage figure {
    margin: 0;
    overflow: hidden;
    background: var(--sand);
  }

  .collage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collage__main {
    grid-row: 1 / 3;
    aspect-ratio: 4 / 3;
  }

  /* Wide photo on top, two upright ones below. */
  .collage__cell:nth-of-type(2) {
    grid-column: 2;
    aspect-ratio: 16 / 9;
  }

  .collage__cell:nth-of-type(3),
  .collage__cell:nth-of-type(4) {
    grid-row: 2;
    aspect-ratio: 3 / 4;
  }

  .collage__cell:nth-of-type(3) {
    grid-column: 2;
    width: calc(50% - 0.25rem);
  }

  .collage__cell:nth-of-type(4) {
    grid-column: 2;
    width: calc(50% - 0.25rem);
    justify-self: end;
  }

  .gal__credit {
    justify-self: end;
    font-size: 0.8125rem;
  }

  .gal__credit:hover {
    color: var(--blue-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .rv__quote {
      transition: none;
    }
  }
</style>
