---
// Copied Google reviews, one at a time, crossfading on their own (left), beside the
// customers' photos, also crossfading (right). No controls: it simply moves.
import { site } from '../data/site';
import { reviews, reviewPhotos } from '../data/reviews';
---

<div class="showcase" data-showcase>
  <div class="rv" data-rv aria-label="Customer reviews">
    <div class="rv__stage">
      {
        reviews.map((r, i) => (
          <article class:list={['rv__quote', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
            <p class="stars" style={`--r: ${r.rating}`} aria-label={`${r.rating} out of 5 stars`}>
              ★★★★★
            </p>
            <blockquote class="rv__text">{r.text}</blockquote>
            <footer class="rv__who">
              <span class="rv__avatar" aria-hidden="true">{r.name.trim()[0]}</span>
              <span>
                <b>{r.name}</b>
                <span class="muted">Google review · {r.when}</span>
              </span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>

  {
    reviewPhotos.length > 0 && (
      <div class="gal" data-gal>
        <div class="gal__frame" style={`--frame-ratio: ${reviewPhotos[0].width / reviewPhotos[0].height}`}>
          {reviewPhotos.map((p, i) => (
            <figure
              class:list={['gal__slide', { 'is-active': i === 0 }]}
              data-ratio={p.width / p.height}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <a class="gal__credit muted" href={site.google.reviewsUrl} target="_blank" rel="noopener">
          Customer photos from Google
        </a>
      </div>
    )
  }
</div>

<script>
  const REVIEW_MS = 7000;
  const PHOTO_MS = 5000;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    // Rotate only while on screen.
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

    // ----- Reviews -----
    const stage = root.querySelector<HTMLElement>('.rv__stage')!;
    const quotes = [...stage.querySelectorAll<HTMLElement>('.rv__quote')];
    let active = 0;
    const fit = () => stage.style.setProperty('--h', `${quotes[active].offsetHeight}px`);
    const showQuote = (i: number) => {
      active = (i + quotes.length) % quotes.length;
      quotes.forEach((q, j) => {
        q.classList.toggle('is-active', j === active);
        q.setAttribute('aria-hidden', String(j !== active));
      });
      fit();
    };
    fit();
    document.fonts?.ready.then(fit);

    // ----- Photos -----
    const frame = root.querySelector<HTMLElement>('.gal__frame');
    const slides = frame ? [...frame.querySelectorAll<HTMLElement>('.gal__slide')] : [];
    let photo = 0;
    const fitFrame = () => {
      if (!frame || !slides.length) return;
      const ratio = Number(slides[photo].dataset.ratio);
      const cap = Math.min(window.innerHeight * 0.78, 760);
      frame.style.setProperty('--frame-h', `${Math.min(frame.clientWidth / ratio, cap)}px`);
    };
    const showPhoto = (i: number) => {
      photo = (i + slides.length) % slides.length;
      slides.forEach((s, j) => {
        s.classList.toggle('is-active', j === photo);
        s.setAttribute('aria-hidden', String(j !== photo));
      });
      fitFrame();
    };
    fitFrame();
    addEventListener('resize', () => {
      fit();
      fitFrame();
    });

    if (reduced) return;

    // One clock drives both.
    let last = performance.now();
    let q = 0;
    let ph = 0;
    const tick = (now: number) => {
      const dt = now - last;
      last = now;
      if (visible && !document.hidden) {
        q += dt;
        ph += dt;
        if (q >= REVIEW_MS) {
          q = 0;
          showQuote(active + 1);
        }
        if (slides.length > 1 && ph >= PHOTO_MS) {
          ph = 0;
          showPhoto(photo + 1);
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>

<style>
  .showcase {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .showcase {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  /* ----- Reviews ----- */
  .rv__stage {
    display: grid;
  }

  :global(.js) .rv__stage {
    position: relative;
    height: var(--h, auto);
    transition: height 0.6s var(--ease);
  }

  .rv__quote {
    grid-area: 1 / 1;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  :global(.js) .rv__quote {
    position: absolute;
    inset: 0 0 auto;
  }

  .rv__quote.is-active {
    opacity: 1;
  }

  .rv__quote:not(.is-active) {
    pointer-events: none;
  }

  .rv__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: pre-line;
  }

  .rv__who {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.9375rem;
  }

  .rv__who > span:last-child {
    display: grid;
  }

  .rv__who b {
    font-weight: 600;
    color: var(--ink);
  }

  .rv__who .muted {
    font-size: 0.8125rem;
  }

  .rv__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-weight: 600;
  }

  /* ----- Photos ----- */
  .gal {
    display: grid;
    gap: 0.75rem;
  }

  .gal__frame {
    display: grid;
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--frame-ratio, 4 / 3);
    background: var(--sand);
  }

  :global(.js) .gal__frame {
    aspect-ratio: auto;
    height: var(--frame-h, 24rem);
    transition: height 0.6s var(--ease);
  }

  .gal__slide {
    grid-area: 1 / 1;
    position: relative;
    margin: 0;
    min-width: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }

  .gal__slide.is-active {
    opacity: 1;
  }

  .gal__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gal__slide figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.75rem;
    background: rgb(255 255 255 / 0.9);
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .gal__credit {
    justify-self: end;
    font-size: 0.8125rem;
  }

  .gal__credit:hover {
    color: var(--blue-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .rv__quote,
    .rv__stage,
    .gal__slide,
    .gal__frame {
      transition: none;
    }
  }
</style>
