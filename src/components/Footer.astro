---
import Logo from './Logo.astro';
import { site, nav, whatsappLink } from '../data/site';
import { products } from '../data/products';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="stack footer__intro">
        <Logo />
        <p class="muted">{site.tagline} Since {site.since}.</p>
      </div>

      <div class="footer__cols">
        <div>
          <p class="eyebrow">Products</p>
          <ul role="list">
            {
              products.slice(0, 7).map((p) => (
                <li>
                  <a href={`/products/${p.slug}`}>{p.name}</a>
                </li>
              ))
            }
            <li><a href="/products">All products</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Company</p>
          <ul role="list">
            {
              nav
                .filter((n) => n.href !== '/products')
                .map((n) => (
                  <li>
                    <a href={n.href}>{n.label}</a>
                  </li>
                ))
            }
            <li><a href="/motorisation">Motorisation</a></li>
            <li><a href="/commercial">Commercial</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Visit</p>
          <address>
            {site.address.line1}<br />
            {site.address.line2}<br />
            {site.address.city} {site.address.postalCode}
          </address>
          <a class="link-arrow footer__map" href={site.mapsUrl} target="_blank" rel="noopener">Directions</a>
        </div>
        <div>
          <p class="eyebrow">Talk to us</p>
          <ul role="list">
            <li><a href={`tel:${site.phones.office.tel}`}>{site.phones.office.display}</a></li>
            <li><a href={`tel:${site.phones.mobile.tel}`}>{site.phones.mobile.display}</a></li>
            <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          </ul>
          {site.hours.map((h) => <p class="muted footer__hours">{h.days}<br />{h.time}</p>)}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-top: clamp(3.5rem, 2rem + 4vw, 6rem);
    font-size: 0.9375rem;
  }

  .footer__top {
    display: grid;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer__intro {
    max-width: 22rem;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 2.5rem 2rem;
  }

  .footer ul {
    display: grid;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .footer ul a,
  .footer__bottom a {
    color: var(--ink-soft);
    transition: color 0.2s var(--ease);
  }

  .footer ul a:hover,
  .footer__bottom a:hover {
    color: var(--blue-ink);
  }

  address {
    margin-top: 1rem;
    font-style: normal;
    color: var(--ink-soft);
  }

  .footer__map {
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .footer__hours {
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  @media (min-width: 1000px) {
    .footer__top {
      grid-template-columns: 1fr 2.4fr;
    }
  }
</style>
