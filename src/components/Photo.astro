---
// A real photograph, shown at its own aspect ratio. Never cropped.
import type { Photo } from '../data/photos';

interface Props {
  photo?: Photo;
  eager?: boolean;
  class?: string;
}
const { photo, eager = false, class: cls } = Astro.props;
---

{
  photo ? (
    <figure class:list={['photo', cls]} style={`aspect-ratio: ${photo.width} / ${photo.height}`}>
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    </figure>
  ) : (
    <slot />
  )
}

<style>
  .photo {
    max-width: 100%;
    background: var(--sand);
  }

  .photo img {
    width: 100%;
    height: auto;
  }
</style>
