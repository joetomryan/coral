---
import { whatsappLink } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'See it in your own window.',
  text = 'We visit, measure and bring fabric samples to your home — free, anywhere in Bengaluru.',
} = Astro.props;
---

<section class="section section--ink cta">
  <div class="container cta__inner reveal">
    <div class="stack">
      <p class="eyebrow">Free home measurement</p>
      <h2 class="h2">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href="/contact">Book a visit</a>
      <a class="btn btn--outline-light" href={whatsappLink()} target="_blank" rel="noopener">
        WhatsApp us
      </a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .cta__inner .btn-row {
      justify-content: flex-end;
    }
  }
</style>
