---
// Drawn illustration of a window dressed with one type of blind. Used wherever we don't
// have real photography yet. The scene is generated to fit the requested aspect ratio,
// so the window is never cropped.
export type BlindKind =
  | 'roller'
  | 'zebra'
  | 'roman'
  | 'vertical'
  | 'wooden'
  | 'bamboo'
  | 'venetian'
  | 'skylight'
  | 'panel'
  | 'printed'
  | 'outdoor'
  | 'industrial';

interface Props {
  kind: BlindKind;
  /** Width / height, e.g. 0.8 for 4:5. */
  ratio?: number;
  /** Fabric colour override. */
  tone?: string;
  /** How far the blind is lowered, 0–1. */
  drop?: number;
  title: string;
  class?: string;
}

const { kind, ratio = 0.8, tone, drop: dropProp, title, class: cls } = Astro.props;

const tones: Record<BlindKind, string> = {
  roller: '#d8d3ca',
  zebra: '#c9ced4',
  roman: '#e0d6c8',
  vertical: '#d3d9df',
  wooden: '#9c7350',
  bamboo: '#c6a46c',
  venetian: '#e9eaea',
  skylight: '#d9d6cf',
  panel: '#d6cfc2',
  printed: '#f1efe9',
  outdoor: '#cfe3e6',
  industrial: '#bcd9e6',
};
const drops: Record<BlindKind, number> = {
  roller: 0.56,
  zebra: 0.72,
  roman: 0.5,
  vertical: 1,
  wooden: 0.62,
  bamboo: 0.58,
  venetian: 0.86,
  skylight: 0.66,
  panel: 1,
  printed: 0.7,
  outdoor: 0.78,
  industrial: 1,
};
const fabric = tone ?? tones[kind];
const drop = dropProp ?? drops[kind];

// Unique ids so several illustrations can share a page.
const uid = `ba${Math.random().toString(36).slice(2, 8)}`;
const id = (n: string) => `${uid}-${n}`;

// Scene geometry.
const W = 1000;
const H = Math.round(W / ratio);
const doorway = kind === 'industrial';
let wh = H * (doorway ? 0.8 : 0.66);
let ww = Math.min(W * 0.78, wh * (doorway ? 0.72 : ratio > 1.4 ? 1.5 : 0.82));
if (ww > W * 0.78) ww = W * 0.78;
const wx = (W - ww) / 2;
const wy = doorway ? H - wh - H * 0.06 : (H - wh) / 2 - H * 0.03;
const f = Math.max(10, ww * 0.03); // frame thickness
const gx = wx + f;
const gy = wy + f;
const gw = ww - 2 * f;
const gh = wh - 2 * f;

// Small helpers for building SVG markup.
const r = (x: number, y: number, w: number, h: number, attrs = '') =>
  `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${Math.max(0, w).toFixed(1)}" height="${Math.max(0, h).toFixed(1)}" ${attrs}/>`;
const l = (x1: number, y1: number, x2: number, y2: number, attrs = '') =>
  `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" ${attrs}/>`;

const shade = (hex: string, amt: number) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.max(0, Math.min(255, Math.round(v + amt * 255))));
  return `#${c.map((v) => v.toString(16).padStart(2, '0')).join('')}`;
};
const dark = shade(fabric, -0.12);
const darker = shade(fabric, -0.22);
const light = shade(fabric, 0.06);

const parts: string[] = [];
const bh = gh * drop; // blind height inside the glass
const head = Math.max(10, gh * 0.045); // headrail / cassette height

const headrail = (x = gx - f * 0.4, w = gw + f * 0.8) =>
  r(x, gy - f * 0.3, w, head, `fill="${shade(fabric, 0.1)}" stroke="${dark}" stroke-width="1.5" rx="3"`);

switch (kind) {
  case 'roller':
  case 'skylight':
  case 'printed': {
    parts.push(r(gx, gy, gw, bh, `fill="url(#${id('fab')})"`));
    if (kind === 'printed') {
      // A soft botanical print in the brand colours.
      const leaves = ['#02807a', '#fdbe02', '#0090fa'];
      let k = 0;
      for (let yy = gy + bh * 0.12; yy < gy + bh - 30; yy += bh / 4.2) {
        for (let xx = gx + gw * 0.12 + (k % 2) * gw * 0.12; xx < gx + gw - 30; xx += gw / 3.2) {
          const c = leaves[k++ % 3];
          const s = Math.min(gw, bh) * 0.11;
          parts.push(
            `<ellipse cx="${xx.toFixed(1)}" cy="${yy.toFixed(1)}" rx="${s.toFixed(1)}" ry="${(s * 0.45).toFixed(1)}" transform="rotate(${(k * 37) % 180} ${xx.toFixed(1)} ${yy.toFixed(1)})" fill="${c}" opacity="0.55"/>`,
          );
        }
      }
    }
    parts.push(r(gx, gy + bh - 8, gw, 8, `fill="${darker}" rx="2"`));
    if (kind === 'skylight') {
      // Side tension cables and a small motor end.
      parts.push(l(gx + 6, gy, gx + 6, gy + gh, `stroke="${darker}" stroke-width="2"`));
      parts.push(l(gx + gw - 6, gy, gx + gw - 6, gy + gh, `stroke="${darker}" stroke-width="2"`));
    }
    parts.push(headrail());
    if (kind !== 'printed') {
      // Pull chain or motor.
      if (kind === 'roller') {
        parts.push(l(gx + gw - 18, gy + head, gx + gw - 18, gy + bh * 0.95, `stroke="${darker}" stroke-width="2.5" stroke-dasharray="2 4"`));
      } else {
        parts.push(`<circle cx="${(gx + gw - 4).toFixed(1)}" cy="${(gy + head / 2 - f * 0.3).toFixed(1)}" r="${(head * 0.42).toFixed(1)}" fill="#02807a"/>`);
      }
    }
    break;
  }
  case 'zebra': {
    const band = Math.max(18, gh * 0.065);
    for (let y = gy, i = 0; y < gy + bh; y += band, i++) {
      const h = Math.min(band, gy + bh - y);
      parts.push(r(gx, y, gw, h, i % 2 === 0 ? `fill="${fabric}"` : `fill="${light}" opacity="0.45"`));
    }
    parts.push(r(gx, gy + bh - 8, gw, 8, `fill="${darker}" rx="2"`));
    parts.push(headrail());
    break;
  }
  case 'roman': {
    const flat = bh * 0.55;
    parts.push(r(gx, gy, gw, flat, `fill="url(#${id('fab')})"`));
    const folds = 4;
    const fh = (bh - flat) / folds;
    for (let i = 0; i < folds; i++) {
      const y = gy + flat + i * fh;
      parts.push(r(gx - 2, y, gw + 4, fh + 2, `fill="url(#${id('fold')})" rx="${(fh / 2.2).toFixed(1)}"`));
    }
    parts.push(headrail());
    break;
  }
  case 'wooden':
  case 'bamboo': {
    parts.push(r(gx, gy, gw, bh, `fill="${fabric}"`));
    const step = kind === 'bamboo' ? 7 : 10;
    for (let y = gy + step; y < gy + bh; y += step) {
      parts.push(l(gx, y, gx + gw, y, `stroke="${kind === 'bamboo' ? dark : darker}" stroke-width="${kind === 'bamboo' ? 1.4 : 2.2}" opacity="0.55"`));
    }
    if (kind === 'wooden') {
      // Woven texture: short vertical stitches.
      for (let x = gx + gw * 0.18; x < gx + gw; x += gw * 0.32) {
        parts.push(l(x, gy, x, gy + bh, `stroke="${shade(fabric, 0.12)}" stroke-width="2" opacity="0.6"`));
      }
    } else {
      for (const x of [gx + gw * 0.2, gx + gw * 0.8]) {
        parts.push(l(x, gy, x, gy + bh + 18, `stroke="${darker}" stroke-width="2"`));
      }
    }
    // Rolled bottom.
    const rr = Math.max(10, gh * 0.03);
    parts.push(r(gx - 4, gy + bh - rr, gw + 8, rr * 2, `fill="${dark}" rx="${rr.toFixed(1)}"`));
    parts.push(r(gx - f * 0.4, gy - f * 0.3, gw + f * 0.8, head, `fill="${darker}" rx="3"`));
    break;
  }
  case 'venetian': {
    const pitch = Math.max(14, gh * 0.04);
    const slat = pitch * 0.62;
    for (let y = gy + head; y < gy + bh; y += pitch) {
      parts.push(r(gx - 4, y, gw + 8, slat, `fill="url(#${id('slat')})" rx="2"`));
    }
    for (const x of [gx + gw * 0.18, gx + gw * 0.5, gx + gw * 0.82]) {
      parts.push(l(x, gy, x, gy + bh, `stroke="${darker}" stroke-width="1.2" opacity="0.6"`));
    }
    parts.push(headrail());
    break;
  }
  case 'vertical': {
    const n = Math.max(7, Math.round(gw / 70));
    const pitch = gw / n;
    for (let i = 0; i < n; i++) {
      const x = gx + i * pitch + pitch * 0.12;
      parts.push(r(x, gy + head * 0.8, pitch * 0.8, bh - head, `fill="url(#${id('louvre')})"`));
    }
    parts.push(headrail());
    break;
  }
  case 'panel': {
    const n = 4;
    const pw = gw / 2.6;
    const offs = [0, pw * 0.82, gw - pw * 1.55, gw - pw];
    offs.forEach((o, i) => {
      parts.push(
        r(gx + o, gy + head, pw, bh - head, `fill="${i % 2 ? light : fabric}" stroke="${dark}" stroke-width="1" opacity="${i === 1 ? 0.75 : 1}"`),
      );
      parts.push(r(gx + o, gy + bh - 10, pw, 10, `fill="${darker}"`));
    });
    void n;
    parts.push(headrail());
    break;
  }
  case 'outdoor': {
    // Clear PVC with a light tint, rain outside, balcony railing.
    for (let i = 0; i < 26; i++) {
      const x = gx + ((i * 97) % gw);
      const y = gy + ((i * 53) % (gh * 0.8));
      parts.push(l(x, y, x - 6, y + 22, `stroke="#9fb7c8" stroke-width="1.5" opacity="0.6"`));
    }
    parts.push(r(gx, gy, gw, bh, `fill="${fabric}" opacity="0.45" stroke="${dark}" stroke-width="2"`));
    parts.push(r(gx, gy + bh - 10, gw, 10, `fill="${darker}"`));
    parts.push(headrail());
    const ry = gy + gh * 0.7;
    parts.push(r(gx, ry, gw, 8, `fill="#7c838c"`));
    for (let x = gx + 20; x < gx + gw; x += 34) parts.push(l(x, ry, x, gy + gh, `stroke="#7c838c" stroke-width="3"`));
    break;
  }
  case 'industrial': {
    const n = Math.max(6, Math.round(gw / 60));
    const sw = gw / n;
    for (let i = 0; i < n; i++) {
      parts.push(r(gx + i * sw - sw * 0.1, gy, sw * 1.2, gh, `fill="${fabric}" opacity="0.5" stroke="${dark}" stroke-width="1"`));
    }
    parts.push(r(gx - f * 0.4, gy - f * 0.3, gw + f * 0.8, head, `fill="#8a9099" rx="2"`));
    break;
  }
}

const blind = parts.join('');
---

<svg
  class:list={['blind-art', cls]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={id('wall')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3f4f6"></stop>
      <stop offset="1" stop-color="#eceef1"></stop>
    </linearGradient>
    <linearGradient id={id('sky')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfe2f2"></stop>
      <stop offset="0.7" stop-color="#e9f2f9"></stop>
      <stop offset="1" stop-color="#f6f9fc"></stop>
    </linearGradient>
    <radialGradient id={id('sun')} cx="0.78" cy="0.12" r="0.6">
      <stop offset="0" stop-color="#fff6d8" stop-opacity="0.95"></stop>
      <stop offset="1" stop-color="#fff6d8" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={id('fab')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={dark}></stop>
      <stop offset="0.5" stop-color={fabric}></stop>
      <stop offset="1" stop-color={light}></stop>
    </linearGradient>
    <linearGradient id={id('fold')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={light}></stop>
      <stop offset="0.7" stop-color={fabric}></stop>
      <stop offset="1" stop-color={darker}></stop>
    </linearGradient>
    <linearGradient id={id('slat')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={light}></stop>
      <stop offset="1" stop-color={dark}></stop>
    </linearGradient>
    <linearGradient id={id('louvre')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={dark}></stop>
      <stop offset="0.35" stop-color={light}></stop>
      <stop offset="1" stop-color={fabric}></stop>
    </linearGradient>
    <linearGradient id={id('floor')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e4e1dc"></stop>
      <stop offset="1" stop-color="#d9d5ce"></stop>
    </linearGradient>
  </defs>

  <rect width={W} height={H} fill={`url(#${id('wall')})`}></rect>
  {doorway && <rect y={H * 0.94} width={W} height={H * 0.06} fill={`url(#${id('floor')})`}></rect>}

  <!-- Frame and glass -->
  <rect x={wx} y={wy} width={ww} height={wh} fill="#ffffff" stroke="#d9dde3" stroke-width="2"></rect>
  <rect x={gx} y={gy} width={gw} height={gh} fill={doorway ? '#59606b' : `url(#${id('sky')})`}></rect>
  {!doorway && <rect x={gx} y={gy} width={gw} height={gh} fill={`url(#${id('sun')})`}></rect>}
  {!doorway && <line x1={gx + gw / 2} y1={gy} x2={gx + gw / 2} y2={gy + gh} stroke="#ffffff" stroke-width={f * 0.6}></line>}

  <g set:html={blind} />

  <!-- Sill -->
  {
    !doorway && (
      <>
        <rect x={wx - f} y={wy + wh} width={ww + 2 * f} height={f * 0.9} fill="#ffffff" stroke="#d9dde3" stroke-width="2" />
      </>
    )
  }
</svg>

<style>
  .blind-art {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
