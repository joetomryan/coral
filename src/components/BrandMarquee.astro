---
import { brands } from '../data/brands';

interface Props {
  title?: string;
}
const { title = 'Brands we work with' } = Astro.props;
// Repeat the list so one copy is always wider than the screen, then render it twice
// so the strip can loop seamlessly by sliding exactly one copy's width.
const minItems = 8;
const copy = Array.from({ length: Math.max(1, Math.ceil(minItems / brands.length)) }, () => brands).flat();
---

<section class="brands" aria-label={title}>
  <div class="container">
    <p class="eyebrow brands__title">{title}</p>
  </div>
  <div class="brands__viewport">
    <ul role="list" class="brands__track">
      {
        [0, 1].map((n) =>
          copy.map((b, i) => (
            <li aria-hidden={n === 1 || i >= brands.length ? 'true' : undefined}>
              {b.logo ? <img src={b.logo} alt={b.name} loading="lazy" /> : <span>{b.name}</span>}
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>

<style>
  .brands {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
    border-block: 1px solid var(--line);
  }

  .brands__title {
    margin-bottom: 2rem;
    text-align: center;
  }

  .brands__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .brands__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .brands__viewport:hover .brands__track {
    animation-play-state: paused;
  }

  .brands__track li {
    display: grid;
    place-items: center;
    flex: none;
    height: 64px;
    padding-inline: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
  }

  .brands__track img {
    max-height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .brands__track li:hover img {
    filter: none;
    opacity: 1;
  }

  .brands__track span {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    color: var(--slate);
    opacity: 0.75;
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brands__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    .brands__track li[aria-hidden] {
      display: none;
    }
  }
</style>
