---
// Placeholder wordmark in the logo colours until we have the logo as SVG / transparent PNG.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<span class:list={['logo', cls]}>
  <span class="logo__mark" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="logo__word">Coral</span>
  <span class="logo__sub">Blinds</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1;
  }

  .logo__mark {
    align-self: center;
    display: grid;
    gap: 2px;
    width: 14px;
  }

  .logo__mark i {
    display: block;
    height: 3px;
  }

  .logo__mark i:nth-child(1) {
    background: var(--green);
  }

  .logo__mark i:nth-child(2) {
    background: var(--yellow);
  }

  .logo__mark i:nth-child(3) {
    background: var(--blue);
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: -0.01em;
  }

  .logo__sub {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
