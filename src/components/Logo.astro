---
import { site } from '../data/site';

interface Props {
  class?: string;
  height?: number;
}
const { class: cls, height = 44 } = Astro.props;
// Source image is 720 × 208.
const width = Math.round((height * 720) / 208);
---

<picture class:list={['logo', cls]}>
  <source srcset="/images/logo.webp" type="image/webp" />
  <img src="/images/logo.png" alt={site.legalName} width={width} height={height} decoding="async" />
</picture>

<style>
  .logo,
  .logo img {
    display: block;
  }
</style>
