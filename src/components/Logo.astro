---
// Placeholder wordmark until the owner supplies the logo.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<span class:list={['logo', cls]}>
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__word">Coral</span>
  <span class="logo__sub">Blinds</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1;
  }

  .logo__mark {
    align-self: center;
    width: 14px;
    height: 14px;
    background: repeating-linear-gradient(180deg, var(--coral) 0 2px, transparent 2px 4px);
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: -0.01em;
  }

  .logo__sub {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
