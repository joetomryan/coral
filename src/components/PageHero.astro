---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="page-hero">
  <div class="container stack">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 5vw, 7rem));
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .page-hero .display {
    max-width: 18ch;
  }
</style>
