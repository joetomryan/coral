---
import { enquiryLink } from '../data/site';
---

<a class="wa" href={enquiryLink()} aria-label="Send us a WhatsApp enquiry">
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.95 12.95 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.64c-2 0-3.95-.54-5.65-1.55l-.4-.24-3.97 1.04 1.06-3.86-.26-.4A10.6 10.6 0 0 1 5.4 16c0-5.86 4.78-10.63 10.65-10.63 5.86 0 10.6 4.77 10.6 10.63 0 5.87-4.75 10.64-10.6 10.64Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.21-.18-.32-.02-.5.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.71-1.71-.98-2.35-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.56.08-.85.4-.29.31-1.11 1.09-1.11 2.66 0 1.56 1.14 3.08 1.3 3.29.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.2 2 .12.61-.09 1.89-.77 2.15-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z"
    ></path>
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    bottom: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.45);
    transition:
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .wa:hover {
    background: #1f9d55;
    transform: translateY(-2px);
  }
</style>
