---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductRows from '../components/ProductRows.astro';
import CtaBand from '../components/CtaBand.astro';
import { getProduct } from '../data/products';

const sectors = [
  { title: 'Offices', text: 'Glare control for screens, consistent façades across floors, and fabrics that meet fire safety needs.' },
  { title: 'Hospitality', text: 'Blackout for guest rooms and soft, tailored fabrics for lobbies and restaurants.' },
  { title: 'Healthcare & education', text: 'Easy to clean, durable systems for wards, clinics and classrooms.' },
  { title: 'Factories & warehouses', text: 'PVC strip curtains for doorways that hold back heat, dust and insects.' },
];
const picks = ['vertical-blinds', 'roller-blinds', 'printed-blinds', 'industrial-strip-curtains']
  .map((s) => getProduct(s)!)
  .filter(Boolean);
---

<Base
  title="Commercial blinds"
  description="Blinds for offices, hotels, hospitals, schools and factories in Bangalore (Bengaluru): vertical, roller, fire retardant fabrics, printed branding and PVC strip curtains."
>
  <PageHero
    eyebrow="Commercial"
    title="Blinds for places that <em>work</em> hard."
    lead="From a single cabin to whole office floors. Measured, supplied and installed by one team, on your schedule."
  >
    <div class="btn-row">
      <a class="btn" href="/contact?type=commercial#book">Request a site visit</a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <dl class="sectors reveal">
        {
          sectors.map((s) => (
            <div class="sector">
              <dt class="h3">{s.title}</dt>
              <dd class="muted">{s.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split">
      <div class="stack reveal">
        <p class="eyebrow">For architects, builders and facility teams</p>
        <h2 class="h2">Specified once. Fitted right.</h2>
      </div>
      <ul role="list" class="list reveal">
        <li>Site survey and measurement across every floor</li>
        <li>Fire retardant, blackout, dim out and solar reflective fabrics</li>
        <li>Blinds printed with your brand for receptions and shopfronts</li>
        <li>Motorised and centrally controlled systems</li>
        <li>Phased installation around your working hours</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">Popular for commercial spaces</h2>
      </div>
      <ProductRows items={picks} />
    </div>
  </section>

  <CtaBand title="Planning a fit out?" text="Share drawings or a window count and we’ll arrange a site visit and an itemised quote." />
</Base>

<style>
  .sectors {
    border-top: 1px solid var(--line);
  }

  .sector {
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 800px) {
    .sector {
      grid-template-columns: 1fr 1.6fr;
      align-items: baseline;
    }
  }

  .list li {
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(29 28 26 / 0.15);
    font-size: var(--step-1);
  }

  .list li:first-child {
    border-top: 1px solid rgb(29 28 26 / 0.15);
  }
</style>
