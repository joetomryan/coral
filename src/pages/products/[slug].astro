---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import ProductRows from '../../components/ProductRows.astro';
import CtaBand from '../../components/CtaBand.astro';
import { products, roomLabel, bestFor, categories, type Product } from '../../data/products';
import { site, enquiryLink } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const category = categories.find((c) => c.id === product.category)!;
const related = products
  .filter((p) => p.slug !== product.slug && (p.category === product.category || p.rooms.some((r) => product.rooms.includes(r))))
  .slice(0, 3);
const url = `${site.url}/products/${product.slug}`;
// A made to measure service in Bangalore, provided by the business on every page.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${product.name} in Bangalore`,
    serviceType: product.name,
    description: product.intro,
    url,
    category: category.label,
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'City', name: 'Bangalore', alternateName: 'Bengaluru' },
    ...(product.image && { image: new URL(product.image.src, site.url).href }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Products', item: `${site.url}/products` },
      { '@type': 'ListItem', position: 2, name: product.name, item: url },
    ],
  },
];
---

<Base
  title={`${product.name} in Bangalore`}
  description={`${product.summary} Made to measure ${product.name.toLowerCase()} in Bangalore (Bengaluru) by ${site.name}, Kothanur. Free home visit, fitted in about a week.`}
  image={product.image?.src}
  schema={schema}
>
  <section class="pd">
    <div class:list={['container', 'pd__grid', { 'pd__grid--text': !product.image }]}>
      {
        product.image && (
          <div class="pd__media">
            <Photo photo={product.image} eager />
          </div>
        )
      }

      <div class="pd__info">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/products">Products</a> <span aria-hidden="true">/</span> <span>{category.label}</span>
        </nav>
        <h1 class="display pd__title">{product.name}</h1>
        {!product.image && <p class="h2 pd__summary"><em>{product.summary}</em></p>}
        <p class="lead">{product.intro}</p>
        <p class="muted pd__local">Measured, made and fitted by our own team across Bangalore, from our studio in Kothanur.</p>

        <div class="btn-row">
          <a class="btn" href={`/contact?product=${product.slug}#book`}>Book a free visit</a>
          <a class="btn btn--ghost" href={enquiryLink(product.slug)}>WhatsApp</a>
        </div>

        <dl class="facts">
          <div>
            <dt>Best for</dt>
            <dd>{product.rooms.map(roomLabel).join(', ')}</dd>
          </div>
          <div>
            <dt>Operation</dt>
            <dd>{product.motorised ? 'Manual or motorised' : 'Manual'}</dd>
          </div>
          {
            product.specs?.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split">
      <div class="stack reveal">
        <p class="eyebrow">Why {product.name.toLowerCase()}</p>
        <h2 class="h2">{product.summary}</h2>
      </div>
      <ul role="list" class="features reveal">
        {product.features.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>


  {
    related.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <div class="section-head">
            <h2 class="h2">You might also consider</h2>
          </div>
          <ProductRows items={related} />
        </div>
      </section>
    )
  }

  <CtaBand title={`See ${product.name} in your window.`} />
</Base>

<style>
  .pd {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 1rem + 2vw, 3rem));
    padding-bottom: var(--section);
  }

  .pd__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  /* No photo yet: a typographic hero instead of a fake image. */
  .pd__grid--text {
    grid-template-columns: 1fr !important;
  }

  .pd__grid--text .pd__info {
    max-width: 52rem;
    padding-top: 0 !important;
  }

  .pd__summary {
    color: var(--muted);
    max-width: 22ch;
  }

  .pd__info {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .crumbs a:hover {
    color: var(--blue-ink);
  }

  .pd__title {
    font-size: clamp(2.75rem, 1.8rem + 3.5vw, 4.75rem);
  }

  .pd__grid--text .pd__title {
    font-size: var(--step-4);
  }

  .facts {
    border-top: 1px solid var(--line);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .facts dt {
    color: var(--muted);
  }

  .features {
    display: grid;
  }

  .features li {
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(29 28 26 / 0.15);
    font-size: var(--step-1);
  }

  .features li:first-child {
    border-top: 1px solid rgb(29 28 26 / 0.15);
  }

  @media (min-width: 960px) {
    .pd__grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .pd__media {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
    }

    .pd__info {
      padding-top: 2rem;
    }
  }
</style>
