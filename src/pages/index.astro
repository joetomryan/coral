---
import Base from '../layouts/Base.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ProductSlider from '../components/ProductSlider.astro';
import Process from '../components/Process.astro';
import FaqList from '../components/FaqList.astro';
import { faqs, faqSchema } from '../data/faq';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { photos } from '../data/photos';

const hero = photos.bambooCafe;
// Slider order: products with photos first, then curtains, then the rest of the catalogue.
const lead = ['roller-blinds', 'zebra-blinds', 'bamboo-blinds', 'smart-curtains', 'curtains', 'shades'];
const slides = [
  ...lead.map((slug) => products.find((p) => p.slug === slug)!).filter(Boolean),
  ...products.filter((p) => !lead.includes(p.slug)),
];
const homeFaqs = faqs.filter((f) => f.home);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: 'en-IN',
    publisher: { '@id': `${site.url}/#business` },
  },
  faqSchema(homeFaqs),
];

// Proof numbers count up on scroll; anything that isn't a plain number stays as written.
const proof = site.proof.map((p) => {
  const m = p.value.match(/^([\d,]+)(\+?)$/);
  return m ? { ...p, count: m[1].replace(/,/g, ''), suffix: m[2] } : p;
});
---

<Base
  title={site.name}
  description="Made to measure blinds, curtains, smart curtains and shades for homes and offices in Bangalore (Bengaluru). Free home visit, fitted in about a week. Studio in Kothanur since 2002."
  schema={schema}
>
  <!-- Hero -->
  <section class="hero" data-hero>
    <img
      class="hero__img"
      src={hero.src}
      alt={hero.alt}
      width={hero.width}
      height={hero.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container container--wide hero__content">
      <h1 class="display hero__title">
        <span class="hero__word">Light, shaped</span>
        <span class="hero__word">for the way</span>
        <span class="hero__word">you&nbsp;<em>live</em>.</span>
      </h1>
      <div class="hero__foot">
        <span class="hero__line" aria-hidden="true"></span>
        <p class="hero__sub">Blinds, curtains and shades · Bengaluru · Since {site.since}</p>
      </div>
    </div>
  </section>

  <Process />

  <!-- Statement + proof -->
  <section class="section section--sand">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{'count' in p ? <span data-countup={p.count} data-suffix={p.suffix}>{p.value}</span> : p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <BrandMarquee />

  <ProductSlider items={slides} />

  <section class="section section--tight">
    <div class="container home-faq">
      <div class="stack reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h2">Good to know.</h2>
        <a class="link-arrow" href="/faq">All questions <span aria-hidden="true">→</span></a>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <GoogleReviews />

  <CtaBand />
</Base>

<script>
  // The hero photo drifts up at a fraction of the scroll speed while it is in view.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const img = hero?.querySelector<HTMLElement>('.hero__img');
  if (hero && img && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const y = Math.min(scrollY, hero.offsetHeight);
      img.style.setProperty('--shift', `${y * 0.18}px`);
    };
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    update();
  }
</script>

<style>
  /* ----- Hero: about three quarters of the screen, like Bandalux ----- */
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    margin-top: var(--header-h);
    height: clamp(560px, 75svh, 1000px);
    overflow: hidden;
    background: var(--slate);
    color: #fff;
  }

  .hero__img {
    position: absolute;
    inset: -20% 0 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: 50% 60%;
    transform: translateY(var(--shift, 0)) scale(1);
    will-change: transform;
    animation: hero-settle 7s var(--ease) both;
  }

  /* On load the photo settles, the words rise in and the line draws down. */
  @keyframes hero-settle {
    from {
      transform: translateY(var(--shift, 0)) scale(1.06);
    }
  }

  .hero__word {
    display: block;
    animation: hero-rise 1s var(--ease) both;
    animation-delay: calc(0.15s + var(--i, 0) * 0.1s);
  }

  .hero__word:nth-child(1) { --i: 0; }
  .hero__word:nth-child(2) { --i: 1; }
  .hero__word:nth-child(3) { --i: 2; }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

  .hero__line {
    transform-origin: top;
    animation: hero-draw 0.9s var(--ease) 0.7s both;
  }

  @keyframes hero-draw {
    from {
      transform: scaleY(0);
    }
  }

  .hero__sub {
    animation: hero-rise 0.9s var(--ease) 1s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__word,
    .hero__line,
    .hero__sub {
      animation: none;
    }
  }

  /* Darken the left side, where the words sit. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.22) 45%, rgb(0 0 0 / 0) 75%),
      linear-gradient(180deg, rgb(0 0 0 / 0.15) 0%, rgb(0 0 0 / 0) 40%, rgb(0 0 0 / 0.25) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(1.75rem, 1rem + 2vw, 3rem);
  }

  .hero__title {
    max-width: 14ch;
    color: #fff;
    font-size: clamp(2.75rem, 1.6rem + 4vw, 5.75rem);
  }

  .hero__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .hero__line {
    width: 1px;
    height: clamp(36px, 2rem + 2vw, 64px);
    background: rgb(255 255 255 / 0.8);
  }

  .hero__sub {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ----- Questions ----- */
  .home-faq {
    display: grid;
    gap: 2.5rem 4rem;
  }

  @media (min-width: 900px) {
    .home-faq {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }

  /* ----- Statement ----- */
  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 22ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }
  }
</style>
