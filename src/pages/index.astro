---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductRows from '../components/ProductRows.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products, categories, getProduct, bestFor } from '../data/products';
import { photos } from '../data/photos';

const hero = photos.bambooCafe;
const featured = [
  { product: getProduct('bamboo-blinds')!, photo: photos.bambooCafe },
  { product: getProduct('zebra-blinds')!, photo: photos.zebraOffice },
  { product: getProduct('roller-blinds')!, photo: photos.rollerLiving },
];
const categoryLabel = (id: string) => categories.find((c) => c.id === id)?.label ?? '';
const steps = [
  { title: 'Visit', text: 'We come to you, measure every window and bring fabric samples to see in your own light.' },
  { title: 'Choose', text: 'Pick fabrics, colours and manual or motorised operation, with honest advice and a clear quote.' },
  { title: 'Make', text: 'Each blind is made to measure for your window, typically ready in about five days.' },
  { title: 'Fit', text: 'Our own team installs, tests and tidies up. We stay on call if anything needs adjusting.' },
];
---

<Base
  title={site.name}
  description="Made to measure roller, zebra, Roman, vertical, wooden and motorised blinds for homes and offices in Bengaluru. Free home visit. Since 2002."
  overlayHeader
>
  <!-- Hero -->
  <section class="hero">
    <img
      class="hero__img"
      src={hero.src}
      alt={hero.alt}
      width={hero.width}
      height={hero.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">Made to measure blinds · Bengaluru · Since {site.since}</p>
      <h1 class="display hero__title">Light, shaped for the way you&nbsp;<em>live</em>.</h1>
      <div class="btn-row">
        <a class="btn btn--light" href="/contact#book">Book a free visit</a>
        <a class="btn btn--outline-light" href="/products">Explore the collection</a>
      </div>
    </div>
  </section>

  <!-- Statement + proof -->
  <section class="section">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          site.proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Featured, editorial -->
  <section class="section section--tight featured">
    {
      featured.map(({ product, photo }, i) => (
        <div class:list={['container', 'split', 'featured__row', { 'split--reverse': i % 2 === 1 }]}>
          <div class="reveal">
            <Photo photo={photo} />
          </div>
          <div class="stack reveal featured__copy">
            <p class="eyebrow">{categoryLabel(product.category)}</p>
            <h2 class="h2">{product.name}</h2>
            <p class="lead">{product.intro}</p>
            <p class="muted featured__for">Best for {bestFor(product).toLowerCase()}</p>
            <a class="link-arrow" href={`/products/${product.slug}`}>
              Explore {product.name.toLowerCase()} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Collection index -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">The collection</p>
          <h2 class="h2">Twelve systems. Every window, considered.</h2>
        </div>
        <a class="link-arrow" href="/products">Browse by room <span aria-hidden="true">→</span></a>
      </div>
      <div class="reveal">
        <ProductRows items={products} />
      </div>
    </div>
  </section>

  <BrandMarquee />

  <GoogleReviews />

  <!-- Process -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">From first visit to final fit.</h2>
        </div>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    min-height: 640px;
    min-height: max(640px, 88svh);
    overflow: hidden;
    background: var(--slate);
    color: #fff;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 45%;
  }

  /* Scrims: one for the header, one for the headline. */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero::before {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0) 28%);
  }

  .hero::after {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 40%, rgb(0 0 0 / 0.6) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-bottom: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero__eyebrow {
    color: var(--yellow);
  }

  .hero__title {
    max-width: 15ch;
    color: #fff;
  }

  .hero__content .btn-row {
    margin-top: 0.75rem;
  }

  /* ----- Statement ----- */
  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 22ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--ink);
  }

  /* ----- Featured ----- */
  .featured {
    display: grid;
    gap: clamp(4rem, 3rem + 5vw, 8rem);
  }

  .featured__copy {
    max-width: 30rem;
  }

  .featured__for {
    font-size: 0.9375rem;
  }

  /* ----- Process ----- */
  .steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }

  .step__num {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--green);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }

    .featured__copy {
      padding-inline: clamp(0rem, -2rem + 4vw, 3rem);
    }
  }
</style>
