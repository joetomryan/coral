---
import Base from '../layouts/Base.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ProductSlider from '../components/ProductSlider.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { photos } from '../data/photos';

const hero = photos.bambooCafe;
// Slider order: products with photos first, then curtains, then the rest of the catalogue.
const lead = ['roller-blinds', 'zebra-blinds', 'bamboo-blinds', 'smart-curtains', 'curtains', 'shades'];
const slides = [
  ...lead.map((slug) => products.find((p) => p.slug === slug)!).filter(Boolean),
  ...products.filter((p) => !lead.includes(p.slug)),
];
const steps = [
  { title: 'Visit', text: 'We come to you, measure every window and bring fabric samples to see in your own light.' },
  { title: 'Choose', text: 'Pick fabrics, colours and manual or motorised operation, with honest advice and a clear quote.' },
  { title: 'Make', text: 'Each blind or curtain is made to measure for your window, typically ready in about five days.' },
  { title: 'Fit', text: 'Our own team installs, tests and tidies up. We stay on call if anything needs adjusting.' },
];
---

<Base
  title={site.name}
  description="Made to measure blinds, curtains, smart curtains and shades for homes and offices in Bengaluru. Free home visit. Since 2002."
  headerBand
>
  <!-- Hero -->
  <section class="hero">
    <img
      class="hero__img"
      src={hero.src}
      alt={hero.alt}
      width={hero.width}
      height={hero.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container container--wide hero__content">
      <h1 class="display hero__title">Light, shaped for the way you&nbsp;<em>live</em>.</h1>
      <div class="hero__foot">
        <span class="hero__line" aria-hidden="true"></span>
        <p class="hero__sub">Blinds, curtains and shades · Bengaluru · Since {site.since}</p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">From first visit to final fit.</h2>
        </div>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Statement + proof -->
  <section class="section section--sand">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          site.proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <BrandMarquee />

  <ProductSlider items={slides} />

  <GoogleReviews />

  <CtaBand />
</Base>

<style>
  /* ----- Hero: a wide band, about 3:1 like Bandalux ----- */
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    margin-top: var(--header-h);
    height: clamp(420px, 34vw, 720px);
    overflow: hidden;
    background: var(--slate);
    color: #fff;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }

  /* Darken the left side, where the words sit. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.22) 45%, rgb(0 0 0 / 0) 75%),
      linear-gradient(180deg, rgb(0 0 0 / 0.15) 0%, rgb(0 0 0 / 0) 40%, rgb(0 0 0 / 0.25) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(1.75rem, 1rem + 2vw, 3rem);
  }

  .hero__title {
    max-width: 13ch;
    color: #fff;
    font-size: clamp(2.75rem, 1.6rem + 4.2vw, 6rem);
  }

  .hero__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .hero__line {
    width: 1px;
    height: clamp(36px, 2rem + 2vw, 64px);
    background: rgb(255 255 255 / 0.8);
  }

  .hero__sub {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ----- Statement ----- */
  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 22ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--ink);
  }

  /* ----- Process ----- */
  .steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }

  .step__num {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--green);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }
  }
</style>
