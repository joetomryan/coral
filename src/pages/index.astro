---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products } from '../data/products';

const featured = products.filter((p) => p.featured);
const steps = [
  { title: 'Visit', text: 'We come to you, measure every window and bring fabric samples to see in your own light.' },
  { title: 'Choose', text: 'Pick fabrics, colours and manual or motorised operation, with honest advice and a clear quote.' },
  { title: 'Make', text: 'Each blind is made to measure for your window, typically ready in about five days.' },
  { title: 'Fit', text: 'Our own team installs, tests and tidies up. We stay on call if anything needs adjusting.' },
];
---

<Base
  title={site.name}
  description="Made to measure roller, zebra, Roman, vertical, wooden and motorised blinds for homes and offices in Bengaluru. Free home visit. Since 2002."
  overlayHeader
>
  <!-- Hero -->
  <section class="hero">
    <Photo
      class="hero__bg"
      alt="Living room with soft light through roller blinds"
      hue={210}
      ratio="auto"
      label="Hero: living room, afternoon light"
      eager
      dark
    />
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">Made to measure blinds · Bengaluru · Since {site.since}</p>
      <h1 class="display hero__title">Light, shaped for the way you&nbsp;<em>live</em>.</h1>
      <div class="btn-row">
        <a class="btn" href="/contact#book">Book a free visit</a>
        <a class="btn btn--outline-light" href="/products">Explore products</a>
      </div>
    </div>
  </section>

  <!-- Intro + proof -->
  <section class="section">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          site.proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">Collection</p>
          <h2 class="h2">Every window, considered.</h2>
        </div>
        <a class="link-arrow" href="/products">View all {products.length} products <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <div class="reveal"><ProductCard product={p} /></div>)}
      </div>
    </div>
  </section>

  <BrandMarquee />

  <GoogleReviews />

  <!-- Process -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">From first visit to final fit.</h2>
        </div>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    align-items: flex-end;
    color: #fff;
  }

  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.25) 0%, transparent 30%, rgb(0 0 0 / 0.45) 100%);
    pointer-events: none;
  }

  .hero :global(.photo__label) {
    top: calc(var(--header-h) + 1rem);
    bottom: auto;
    right: 1rem;
    left: auto;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero__eyebrow {
    color: var(--yellow);
    margin-bottom: 1.25rem;
  }

  .hero__title {
    max-width: 13ch;
    margin-bottom: 2.25rem;
  }

  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 24ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--green);
  }

  .steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 2px solid var(--green);
  }

  .step__num {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--blue);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }
  }
</style>
