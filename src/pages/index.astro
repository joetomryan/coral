---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products } from '../data/products';

const featured = products.filter((p) => p.featured);
const steps = [
  { title: 'Visit', text: 'We come to you, measure every window and bring fabric samples to see in your own light.' },
  { title: 'Choose', text: 'Pick fabrics, colours and manual or motorised operation, with honest advice and a clear quote.' },
  { title: 'Make', text: 'Each blind is made to measure for your window, typically ready in about five days.' },
  { title: 'Fit', text: 'Our own team installs, tests and tidies up. We stay on call if anything needs adjusting.' },
];
---

<Base
  title={site.name}
  description="Made to measure roller, zebra, Roman, vertical, wooden and motorised blinds for homes and offices in Bengaluru. Free home visit. Since 2002."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Made to measure blinds · Bengaluru · Since {site.since}</p>
        <h1 class="display hero__title">Light, shaped for the way you&nbsp;<em>live</em>.</h1>
        <p class="lead">
          Roller, zebra, Roman, wooden and motorised blinds, measured in your home and fitted by our own team.
        </p>
        <div class="btn-row">
          <a class="btn" href="/contact#book">Book a free visit</a>
          <a class="btn btn--ghost" href="/products">Explore products</a>
        </div>
      </div>
      <div class="hero__art">
        <Photo alt="A window with a zebra blind" art="zebra" ratio="1 / 1" eager />
        <span class="hero__tag"><b>Free home visit</b> We measure and bring samples</span>
      </div>
    </div>
  </section>

  <!-- Intro + proof -->
  <section class="section">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          site.proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">Collection</p>
          <h2 class="h2">Every window, considered.</h2>
        </div>
        <a class="link-arrow" href="/products">View all {products.length} products <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <div class="reveal"><ProductCard product={p} /></div>)}
      </div>
    </div>
  </section>

  <BrandMarquee />

  <GoogleReviews />

  <!-- Process -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">From first visit to final fit.</h2>
        </div>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(1.5rem, 1rem + 2vw, 3rem));
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .hero__title {
    max-width: 12ch;
  }

  .hero__copy .btn-row {
    margin-top: 0.5rem;
  }

  .hero__art {
    position: relative;
  }

  .hero__tag {
    position: absolute;
    left: clamp(-1.5rem, -2vw, -0.5rem);
    bottom: 2rem;
    display: grid;
    gap: 0.15rem;
    max-width: 15rem;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border-left: 3px solid var(--yellow);
    box-shadow: 0 18px 40px -20px rgb(35 38 45 / 0.35);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .hero__tag b {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 899px) {
    .hero__tag {
      left: 1rem;
    }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 24ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--green);
  }

  .steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 2px solid var(--green);
  }

  .step__num {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--blue-ink);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }
  }
</style>
