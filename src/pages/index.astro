---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductRows from '../components/ProductRows.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { products, getProduct } from '../data/products';
import { photos } from '../data/photos';

const hero = photos.bambooCafe;
// The three products with photos lead the collection; the other nine follow as a list.
const featuredSlugs = ['bamboo-blinds', 'zebra-blinds', 'roller-blinds'];
const featured = featuredSlugs.map((slug, i) => {
  const product = getProduct(slug)!;
  return { product: { ...product, index: i + 1 }, photo: product.image ?? photos.bambooCafe };
});
const rest = products.filter((p) => !featuredSlugs.includes(p.slug));
const steps = [
  { title: 'Visit', text: 'We come to you, measure every window and bring fabric samples to see in your own light.' },
  { title: 'Choose', text: 'Pick fabrics, colours and manual or motorised operation, with honest advice and a clear quote.' },
  { title: 'Make', text: 'Each blind is made to measure for your window, typically ready in about five days.' },
  { title: 'Fit', text: 'Our own team installs, tests and tidies up. We stay on call if anything needs adjusting.' },
];
---

<Base
  title={site.name}
  description="Made to measure roller, zebra, Roman, vertical, wooden and motorised blinds for homes and offices in Bengaluru. Free home visit. Since 2002."
  headerBand
>
  <!-- Hero -->
  <section class="hero">
    <img
      class="hero__img"
      src={hero.src}
      alt={hero.alt}
      width={hero.width}
      height={hero.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">Made to measure blinds · Bengaluru · Since {site.since}</p>
      <h1 class="display hero__title">Light, shaped for the way you&nbsp;<em>live</em>.</h1>
      <div class="btn-row">
        <a class="btn btn--light" href="/contact#book">Book a free visit</a>
        <a class="btn btn--outline-light" href="/products">Explore the collection</a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">From first visit to final fit.</h2>
        </div>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Statement + proof -->
  <section class="section section--sand">
    <div class="container intro reveal">
      <p class="h2 intro__statement">
        For over two decades we’ve made blinds for Bengaluru homes and workplaces. Every one is measured, made and
        fitted by <em>one&nbsp;team</em>.
      </p>
      <dl class="proof">
        {
          site.proof.map((p) => (
            <div>
              <dt class="muted">{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <BrandMarquee />

  <!-- Collection: three with photos, the rest as a list -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">The collection</p>
          <h2 class="h2">Twelve systems. Every window, considered.</h2>
        </div>
        <a class="link-arrow" href="/products">Browse by room <span aria-hidden="true">→</span></a>
      </div>

      <div class="featured grid grid--3">
        {
          featured.map(({ product, photo }) => (
            <a class="feat reveal" href={`/products/${product.slug}`}>
              <Photo photo={photo} />
              <span class="feat__body">
                <span class="row__num">{String(product.index).padStart(2, '0')}</span>
                <span class="feat__name">{product.name}</span>
                <span class="muted feat__summary">{product.summary}</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="reveal">
        <ProductRows items={rest} start={4} />
      </div>
    </div>
  </section>

  <GoogleReviews />

  <CtaBand />
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    margin-top: var(--header-h);
    min-height: 560px;
    min-height: max(560px, calc(100svh - var(--header-h)));
    overflow: hidden;
    background: var(--slate);
    color: #fff;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 45%;
  }

  /* Scrims: one for the header, one for the headline. */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero::before {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0) 25%);
  }

  .hero::after {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 30%, rgb(0 0 0 / 0.3) 55%, rgb(0 0 0 / 0.65) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-bottom: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero__eyebrow {
    color: var(--yellow);
  }

  .hero__title {
    max-width: 15ch;
    color: #fff;
  }

  .hero__content .btn-row {
    margin-top: 0.75rem;
  }

  /* ----- Statement ----- */
  .intro {
    display: grid;
    gap: 3.5rem;
  }

  .intro__statement {
    max-width: 22ch;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .proof dt {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .proof dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    margin-top: 0.25rem;
    color: var(--ink);
  }

  /* ----- Featured tiles ----- */
  .featured {
    margin-bottom: clamp(2rem, 1rem + 2vw, 3rem);
  }

  /* Photos keep their own shapes; captions line up along the bottom. */
  .feat {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }

  .feat :global(.photo) {
    align-self: end;
  }

  .feat :global(.photo) {
    overflow: hidden;
  }

  .feat :global(img) {
    transition: transform 1.2s var(--ease);
  }

  .feat:hover :global(img) {
    transform: scale(1.03);
  }

  .feat__body {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }

  .feat__body .row__num {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--green);
  }

  .feat__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .feat__summary {
    grid-column: 2;
    font-size: 0.9375rem;
  }

  /* ----- Process ----- */
  .steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }

  .step__num {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--green);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }

    .proof {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 2.5rem;
    }
  }
</style>
