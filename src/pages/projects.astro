---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';

// Placeholder gallery: replace each entry with a real install photo (put files in
// public/images/projects/ and add `src`).
const projects: { title: string; place: string; hue: number; ratio: string; src?: string }[] = [
  { title: 'Roller blinds, living room', place: 'Bengaluru', hue: 30, ratio: '4 / 5' },
  { title: 'Vertical blinds, office floor', place: 'Bengaluru', hue: 210, ratio: '4 / 3' },
  { title: 'Wooden blinds, balcony', place: 'Bengaluru', hue: 38, ratio: '4 / 3' },
  { title: 'Zebra blinds, bedroom', place: 'Bengaluru', hue: 220, ratio: '4 / 5' },
  { title: 'Roman blinds, nursery', place: 'Bengaluru', hue: 12, ratio: '4 / 5' },
  { title: 'Skylight blinds, villa', place: 'Bengaluru', hue: 195, ratio: '4 / 3' },
];
---

<Base
  title="Projects"
  description="Recent blinds installations by Coral Blinds across Bengaluru homes, offices and commercial spaces."
>
  <PageHero
    eyebrow="Projects"
    title="Recent <em>work</em> across Bengaluru."
    lead="A selection of homes and workplaces we’ve measured, made and fitted for."
  />

  <section class="section section--tight">
    <div class="container masonry">
      {
        projects.map((p) => (
          <figure class="proj reveal">
            <Photo src={p.src} alt={`${p.title} in ${p.place}`} hue={p.hue} ratio={p.ratio} label={p.title} />
            <figcaption>
              <span>{p.title}</span>
              <span class="muted">{p.place}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .masonry {
    columns: 1;
    column-gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }

  .proj {
    break-inside: avoid;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .proj figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    font-size: 0.9375rem;
  }

  @media (min-width: 700px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 1100px) {
    .masonry {
      columns: 3;
    }
  }
</style>
