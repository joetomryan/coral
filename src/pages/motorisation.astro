---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';

const motorisable = products.filter((p) => p.motorised).slice(0, 6);
const controls = [
  { title: 'Remote', text: 'A single handset for one blind or a whole room, grouped the way you use them.' },
  { title: 'Wall switch', text: 'A discreet switch by the door, wired or wireless, for everyone in the house.' },
  { title: 'Phone & voice', text: 'Control from an app, or with your voice through a smart home assistant.' },
  { title: 'Schedules', text: 'Close before the afternoon sun hits and open with your alarm, automatically.' },
];
---

<Base
  title="Motorised blinds"
  description="Motorised blinds in Bengaluru with Somfy and Lutron motors. Control by remote, wall switch, phone or voice. Ideal for skylights and large windows."
>
  <PageHero
    eyebrow="Motorisation"
    title="Blinds that <em>move</em> for you."
    lead="Motors from Somfy (France) and Lutron (USA), fitted to roller, zebra, Roman, vertical, skylight and printed blinds. Quiet, reliable and easy to live with."
  />

  <section class="section section--tight">
    <div class="container">
      <Photo alt="Motorised roller blinds across a wide window" art="roller" ratio="21 / 9" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="stack">
          <p class="eyebrow">Control</p>
          <h2 class="h2">However you like to live.</h2>
        </div>
      </div>
      <div class="grid grid--4">
        {
          controls.map((c) => (
            <div class="ctl reveal">
              <h3 class="h3">{c.title}</h3>
              <p class="muted">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split">
      <div class="stack reveal">
        <p class="eyebrow">Where it matters most</p>
        <h2 class="h2">Skylights, double height glass and windows out of reach.</h2>
        <p class="lead">
          Some windows simply can’t be reached by hand. Motorised skylight systems are made to fit unusual shapes and
          run from a remote, a wall switch or your phone.
        </p>
        <a class="link-arrow" href="/products/skylight-blinds">Skylight blinds <span aria-hidden="true">→</span></a>
      </div>
      <div class="reveal">
        <Photo alt="Skylight with a motorised blind" art="skylight" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="stack">
          <p class="eyebrow">Available motorised</p>
          <h2 class="h2">Choose a blind, add a motor.</h2>
        </div>
      </div>
      <div class="grid grid--3">
        {motorisable.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Try motorisation at home." text="We’ll demonstrate the options on your own windows and quote manual and motorised side by side." />
</Base>

<style>
  .ctl {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
</style>
