---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found" description="The page you were looking for doesn’t exist.">
  <PageHero eyebrow="404" title="This window’s <em>closed</em>." lead="The page you were looking for has moved or no longer exists.">
    <div class="btn-row">
      <a class="btn" href="/">Back to home</a>
      <a class="btn btn--ghost" href="/products">Browse products</a>
    </div>
  </PageHero>
  <div class="section"></div>
</Base>
