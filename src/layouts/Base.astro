---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PageTransition from '../components/PageTransition.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { allAreas } from '../data/areas';

interface Props {
  title: string;
  description: string;
  overlayHeader?: boolean;
  /** Share preview image: a path under public/ (defaults to the site preview card). */
  image?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}
const { title, description, overlayHeader = false, image, schema = [] } = Astro.props;
const logoUrl = new URL('/images/logo.png', site.url).href;
const ogImage = new URL(image ?? '/og.jpg', site.url).href;
const fullTitle =
  title === site.name ? `${site.name} | Blinds and curtains in Bangalore since ${site.since}` : `${title} | ${site.name}`;
// Clean URLs: the host serves /about for about.html, so drop the extension.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(cleanPath || '/', site.url).href;

// The business, on every page. Other pages point at it through its @id.
const businessId = `${site.url}/#business`;
const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  '@id': businessId,
  name: site.name,
  description: site.tagline,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phones.office.tel,
  foundingDate: String(site.since),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:30',
      closes: '18:30',
    },
  ],
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.latitude, longitude: site.geo.longitude },
  hasMap: site.google.mapsPlaceUrl,
  areaServed: [
    { '@type': 'City', name: 'Bangalore', alternateName: 'Bengaluru' },
    ...allAreas.map((name) => ({ '@type': 'Place', name: `${name}, Bangalore` })),
  ],
  knowsAbout: ['Window blinds', 'Curtains', 'Motorised blinds', 'Smart curtains', 'Made to measure window coverings'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Blinds and curtains',
    itemListElement: products.map((p) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: p.name, url: `${site.url}/products/${p.slug}` },
    })),
  },
  logo: logoUrl,
  image: [new URL('/og.jpg', site.url).href, logoUrl],
  sameAs: [site.social.facebook, site.google.mapsPlaceUrl],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Arrived through a page transition: keep the page white until the curtain opens.
      try {
        if (sessionStorage.getItem('pt')) {
          sessionStorage.removeItem('pt');
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('pt-in');
        }
      } catch (e) {}
      // Remember where this visitor first came from, so a WhatsApp enquiry can say so.
      try {
        if (!sessionStorage.getItem('coral-source')) {
          var q = new URLSearchParams(location.search);
          var utm = (q.get('utm_source') || '').toLowerCase();
          var ref = '';
          try { ref = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
          if (ref === location.hostname || /(^|\.)coralblinds\.in$/.test(ref)) ref = '';
          var hay = utm + ' ' + ref;
          var map = [
            ['chatgpt', 'ChatGPT'], ['openai', 'ChatGPT'], ['perplexity', 'Perplexity'], ['gemini', 'Gemini'],
            ['copilot', 'Copilot'], ['claude', 'Claude'], ['google', 'Google'], ['bing', 'Bing'],
            ['facebook', 'Facebook'], ['fb', 'Facebook'], ['instagram', 'Instagram'], ['youtube', 'YouTube'],
            ['justdial', 'Justdial'], ['whatsapp', 'WhatsApp'], ['linkedin', 'LinkedIn']
          ];
          var source = 'Direct or WhatsApp link';
          if (q.has('fbclid')) source = 'Facebook or Instagram';
          if (q.has('gclid')) source = 'Google Ads';
          for (var i = 0; i < map.length; i++) {
            if (hay.indexOf(map[i][0]) !== -1) { source = map[i][1]; break; }
          }
          if (source === 'Direct or WhatsApp link' && (utm || ref)) source = utm || ref;
          sessionStorage.setItem('coral-source', JSON.stringify({ source: source, landing: location.pathname }));
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([business, ...schema])} />
  </head>
  <body>
    <PageTransition />
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      import '../scripts/countup';

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal, .reveal--wipe, .reveal-stagger').forEach((el) => io.observe(el));
      document.querySelectorAll('.reveal-stagger').forEach((group) =>
        [...group.children].forEach((child, i) => (child as HTMLElement).style.setProperty('--i', String(i))),
      );
    </script>
  </body>
</html>
